<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="800.0" prefHeight="768.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arctany.aivirtualassistant.controller.MainController">
   <center>
      <WebView fx:id="avatarView" prefHeight="400.0" prefWidth="600.0" BorderPane.alignment="CENTER" />
   </center>
   <right>
      <VBox prefHeight="768.0" prefWidth="300.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="5.0">
               <Label text="%customize.avatar" style="-fx-font-weight: bold;"/>
               <Label fx:id="statusLabel" text="%app.welcome" HBox.hgrow="ALWAYS" style="-fx-font-style: italic;"/>
            </HBox>
            <ImageView fx:id="cameraPreview" fitHeight="200.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true" />
            <Label text="%main.clear" style="-fx-font-weight: bold;"/>
            <TextArea fx:id="chatHistoryArea" editable="false" prefHeight="400.0" prefWidth="200.0" wrapText="true" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <TextField fx:id="userInputField" promptText="%main.message.placeholder" HBox.hgrow="ALWAYS" />
                  <Button fx:id="sendButton" mnemonicParsing="false" text="%main.send" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </right>
   <bottom>
      <HBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="languageButton" mnemonicParsing="false" text="%customize.language" onAction="#showLanguageSwitcher"/>
            <HBox HBox.hgrow="ALWAYS" />
            <Button fx:id="customizeButton" mnemonicParsing="false" text="%main.customize" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane> 